# Dev local uniquement — ne pas utiliser pour le worker prod Render (voir .env.worker.prod.example).
DATABASE_URL=postgres://sondage:sondage@localhost:5432/sondage
REDIS_URL=redis://localhost:6379
PORT=3000
JWT_SECRET=change-me-in-production
DEFAULT_DATA_REGION=EU
PARTICIPATION_HASH_SALT=change-me-for-anonymous-polls

# Plateformes autorisées sur cette instance (CSV). Absent = toutes (facebook,x,linkedin,google,apple,mock).
# Dev local : mock,facebook,google — Pilote/prod : facebook
# ENABLED_PLATFORMS=mock,facebook,google

# ALLOW_MULTI_PLATFORM_AUTH=true

# Conformité RGPD — prototype (warnings) ou production (bloque le démarrage si échec).
# COMPLIANCE_MODE=prototype
# GDPR_MANUAL_ATTESTATION_VERSION=2026-06-09

# Logs PII (subjectId) — interdit en production (LOG_PII=true bloque le gate).
# LOG_PII=false

# CORS — absent ou * = tout autoriser (dev). Ex. prod :
# CORS_ORIGINS=https://sondage.example.com,https://www.example.com
# CORS_ORIGINS=*

# Rate limiting (global par IP + votes par subject via Redis)
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_GLOBAL_MAX=100
# RATE_LIMIT_GLOBAL_WINDOW_MS=60000
# RATE_LIMIT_VOTES_PER_MINUTE=5

# Worker — agrégation des votes (vérifie le stream toutes les N ms, traite seulement s'il y a du travail)
# WORKER_POLL_INTERVAL_MS=60000

# Logs perf JSON (vote, mock login, worker tick) — activé en charge / diagnostic
# PERF_LOG=false

# URL publique de l’API (redirect OAuth, liens embed)
# En local : http://localhost:3000
# Sur Render : laisser vide — RENDER_EXTERNAL_URL est utilisé automatiquement
# PUBLIC_BASE_URL=http://localhost:3000

# Google OAuth (quand projet Google Cloud disponible — platform=google)
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Meta / Facebook Login (Lot 3 pilote — platform=facebook)
# https://developers.facebook.com/ → App → Facebook Login → Settings
# Valid OAuth Redirect URI : {PUBLIC_BASE_URL}/auth/facebook/callback
# OAUTH_FACEBOOK_APP_ID=
# OAUTH_FACEBOOK_APP_SECRET=
# OAUTH_FACEBOOK_REDIRECT_URI=http://localhost:3000/auth/facebook/callback
# Callback suppression Meta (status URL — dérivée de PUBLIC_BASE_URL par défaut)
# META_DATA_DELETION_STATUS_URL={PUBLIC_BASE_URL}/legal/data-deletion.html

# Apple — Phase 3, non implémenté
# OAUTH_APPLE_*
