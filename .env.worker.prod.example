# Worker production self-hosted — agrège les votes pour l’API Render.
# Copier vers .env.worker.prod (gitignored) et renseigner les valeurs Render Dashboard.
#
# Postgres : Info → External connection string + ?sslmode=require
# Redis    : Connect → External URL (rediss://…) après allowlist IP du worker
#
# JWT_SECRET et PARTICIPATION_HASH_SALT : identiques au service web Render (Dashboard → sondage).

DATABASE_URL="postgresql://sondage:CHANGE_ME@dpg-CHANGE_ME.frankfurt-postgres.render.com/sondage?sslmode=require"
REDIS_URL="rediss://red-CHANGE_ME:CHANGE_ME@CHANGE_ME-kv.render.com:6379"

JWT_SECRET=copy-from-render-dashboard
PARTICIPATION_HASH_SALT=copy-from-render-dashboard
COMPLIANCE_MODE=prototype
ENABLED_PLATFORMS=facebook
DEFAULT_DATA_REGION=EU

# Agrégation plus réactive sous charge (aligner WORKER_POLL_INTERVAL_MS sur l’API Render)
WORKER_POLL_INTERVAL_MS=5000
WORKER_MAX_EVENTS_PER_TICK=500
# Snapshot — même valeur sur l’API Render et le worker (défaut 60000)
# SNAPSHOT_MIN_INTERVAL_MS=60000
VOTE_EVENTS_STREAM=vote:events
HOSTNAME=home-prod-worker-1

# PERF_LOG=true
