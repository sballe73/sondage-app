# Copier vers infra/logs/.env.logs (gitignored) et renseigner les valeurs.
# Hostname DuckDNS pour la réception syslog TLS (sans https://).
LOG_HOSTNAME=sondage-logs.duckdns.org

# Token DuckDNS (https://www.duckdns.org → votre sous-domaine → token).
DuckDNS_Token=CHANGE_ME

# Sous-domaine DuckDNS seul (partie avant .duckdns.org), pour la mise à jour IP.
DuckDNS_Domain=sondage-logs

# Email Let's Encrypt (notifications d'expiration ; acme.sh).
ACME_EMAIL=you@example.com

# Secret partagé avec Render (Dashboard → Log Streams → Token).
# Générer : npm run logs:generate-token
LOG_STREAM_TOKEN=CHANGE_ME
